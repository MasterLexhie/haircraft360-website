# Copy to .env.local for development. Never commit real values.
# Names are the same in every environment; only the values change.
# Variables starting with NEXT_PUBLIC_ are visible in the browser. Everything else is server only.

# Prisma runtime connection. Local Postgres in development; Supabase pooled connection in production.
DATABASE_URL="postgresql://postgres@localhost:5432/haircraft360_dev"
# Prisma migrations (direct connection). Same as DATABASE_URL locally.
DIRECT_URL="postgresql://postgres@localhost:5432/haircraft360_dev"
# Supabase's CA certificate (Database settings, SSL), pasted as text. The app then checks the
# database's certificate as well as encrypting. Empty locally. Migrations use DIRECT_URL, so add
# ?sslmode=require to DIRECT_URL on Supabase.
DATABASE_CA_CERT=""
# Integration tests only. Must point at a local database; it is wiped between test files.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/haircraft360_test"

# Paystack: Settings, API Keys and Webhooks. Test keys in development, live keys at launch.
# Also used to verify webhook signatures (Paystack has no separate webhook secret).
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Match the Paystack dashboard: Settings > Preferences > "pass fees to customers". Only changes
# what the site tells customers; the money is recorded correctly either way.
PAYSTACK_CUSTOMER_PAYS_FEES="true"

# Email: "console" or "mailpit" in development, "resend" in production.
EMAIL_TRANSPORT="console"
# Local Mailpit inbox (brew install mailpit; run `mailpit`), used when EMAIL_TRANSPORT="mailpit".
MAILPIT_URL="http://127.0.0.1:8025"
RESEND_API_KEY=""
# Verifies Resend delivery and bounce webhooks (first two weeks after launch).
RESEND_WEBHOOK_SECRET=""
# Sender on a domain verified in Resend, for example: Haircraft 360 <bookings@example.com>
EMAIL_FROM="Haircraft 360 <bookings@example.test>"
# Staging only: comma-separated addresses, or "@domain" for a whole domain. Email goes only to
# these; others are marked "not sent". On staging with this empty, nothing is sent. Empty in production.
EMAIL_ALLOWLIST=""
# Where owner alerts and the daily summary go.
OWNER_NOTIFICATION_EMAIL="owner@example.test"

# Sent by cron-job.org as a header to /api/cron/notifications. Generate a long random string.
CRON_SECRET="change-me-to-a-long-random-string"
# Signs admin session cookies. Generate a long random string (for example: openssl rand -base64 48).
AUTH_SECRET="change-me-to-a-long-random-string"

# Local admin made by `npm run db:seed` (owner@example.test unless set). Leave the password empty
# and the seed prints one; or set your own so it survives re-seeding. `npm run admin` resets it.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# "staging" on the developer's test copy: no search indexing, robots.txt blocks everything,
# every page shows a Staging mark, and email only goes to EMAIL_ALLOWLIST. Empty elsewhere.
SITE_ENV=""

# Absolute links in emails, payment pages and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Which host sets the visitor's IP header the rate limits trust: "netlify" or "cloudflare".
# Leave empty locally. Must match the host in staging and production, or visitors could fake their IP.
TRUSTED_PROXY=""

# Date maths. Fixed.
SALON_TIMEZONE="Africa/Lagos"
# Number used by the admin's "Contact your developer" button, in international format without +.
DEVELOPER_CONTACT_WHATSAPP="2348000000000"

