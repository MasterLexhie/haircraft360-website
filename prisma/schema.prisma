// Haircraft 360 data model. See docs/BUILD_SPEC.md Section 5 and docs/FINAL_PLAN.md.
//
// Conventions:
// - Money is integer kobo (NGN x 100). Never floats.
// - Every timestamp is timestamptz, stored in UTC. The UI shows Africa/Lagos time.
// - Secrets handed to customers or admins (booking links, payment links, sessions)
//   are stored only as SHA-256 hashes.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum BookingStatus {
  pending_payment
  confirmed
  completed
  cancelled
  no_show
  expired
  needs_attention

  @@map("booking_status")
}

enum BookingItemKind {
  main // the main service picked by the customer
  add_on // an extra picked by the customer when booking
  extra // added by the salon on the day

  @@map("booking_item_kind")
}

enum PaymentType {
  deposit
  balance_online
  manual
  adjustment

  @@map("payment_type")
}

enum PaymentMethod {
  card
  transfer
  cash
  other

  @@map("payment_method")
}

enum PaymentStatus {
  success
  failed

  @@map("payment_status")
}

enum PaymentAttemptStatus {
  initialized
  success
  failed
  abandoned

  @@map("payment_attempt_status")
}

enum PaymentAttemptPurpose {
  deposit
  balance_online

  @@map("payment_attempt_purpose")
}

enum PaymentLinkPurpose {
  balance

  @@map("payment_link_purpose")
}

enum WebhookEventStatus {
  received
  processed
  ignored
  failed

  @@map("webhook_event_status")
}

enum NotificationType {
  confirmation
  reminder
  owner_alert
  owner_daily_summary
  application_received

  @@map("notification_type")
}

enum NotificationChannel {
  email
  whatsapp_manual

  @@map("notification_channel")
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  skipped
  bounced

  @@map("notification_status")
}

enum DepositType {
  fixed
  percent

  @@map("deposit_type")
}

enum DepositScope {
  main_only
  full_total

  @@map("deposit_scope")
}

// ───────────────────────────── Customers ─────────────────────────────

model Customer {
  id                 String    @id @default(cuid())
  displayName        String    @map("display_name")
  notes              String    @default("")
  tags               String[]  @default([])
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  phones       CustomerPhone[]
  emails       CustomerEmail[]
  nameVariants CustomerNameVariant[]
  bookings     Booking[]

  @@map("customers")
}

/// Phones are stored in E.164 (for example +2348031234567) and are unique across customers.
model CustomerPhone {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  e164       String   @unique
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_phones")
}

/// Emails are trimmed and lowercased, unique across customers.
/// Placeholders (generated from the phone for Paystack) and bounced addresses are never emailed.
model CustomerEmail {
  id            String    @id @default(cuid())
  customerId    String    @map("customer_id")
  value         String    @unique
  isPlaceholder Boolean   @default(false) @map("is_placeholder")
  bouncedAt     DateTime? @map("bounced_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_emails")
}

/// Every name a customer has typed. Kept for the record, never used for matching.
model CustomerNameVariant {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  name       String
  firstUsed  DateTime @default(now()) @map("first_used") @db.Timestamptz(3)
  lastUsed   DateTime @default(now()) @map("last_used") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, name])
  @@map("customer_name_variants")
}

// ───────────────────────────── Services ─────────────────────────────

model Service {
  id                   String   @id @default(cuid())
  name                 String
  description          String   @default("")
  priceKobo            Int      @map("price_kobo")
  durationMinutes      Int      @map("duration_minutes")
  bookableAlone        Boolean  @default(true) @map("bookable_alone")
  availableAsAddOn     Boolean  @default(false) @map("available_as_add_on")
  /// Price and duration when sold as an add-on. Falls back to priceKobo and durationMinutes.
  addOnPriceKobo       Int?     @map("add_on_price_kobo")
  addOnDurationMinutes Int?     @map("add_on_duration_minutes")
  active               Boolean  @default(true)
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  addOns       ServiceAddOn[] @relation("MainService")
  addOnFor     ServiceAddOn[] @relation("AddOnService")
  bookingItems BookingItem[]

  @@map("services")
}

/// Which add-ons each main service offers.
model ServiceAddOn {
  mainServiceId  String @map("main_service_id")
  addOnServiceId String @map("add_on_service_id")

  mainService  Service @relation("MainService", fields: [mainServiceId], references: [id], onDelete: Cascade)
  addOnService Service @relation("AddOnService", fields: [addOnServiceId], references: [id], onDelete: Cascade)

  @@id([mainServiceId, addOnServiceId])
  @@map("service_add_ons")
}

// ───────────────────────────── Bookings ─────────────────────────────

model Booking {
  id                String        @id @default(cuid())
  /// Short human reference shown to customers, for example HC-7KQ2M.
  reference         String        @unique
  /// SHA-256 of the customer's booking link token.
  accessTokenHash   String        @unique @map("access_token_hash")
  /// SHA-256 of the link token used in emails and WhatsApp messages (see src/server/booking-access.ts).
  messageTokenHash  String?       @unique @map("message_token_hash")
  accessExpiresAt   DateTime      @map("access_expires_at") @db.Timestamptz(3)
  customerId        String        @map("customer_id")
  /// What the customer typed for this booking. Customer pages show only these, never the stored profile.
  contactName       String        @map("contact_name")
  contactPhone      String        @map("contact_phone")
  contactEmail      String?       @map("contact_email")
  /// The customer's answer to "This number is on WhatsApp", asked only when they have no email
  /// (true otherwise). When false, the admin calls or texts instead of opening WhatsApp.
  contactOnWhatsapp Boolean       @default(true) @map("contact_on_whatsapp")
  startAt           DateTime      @map("start_at") @db.Timestamptz(3)
  /// Includes every item's duration. The buffer is added at availability time, not stored here.
  endAt             DateTime      @map("end_at") @db.Timestamptz(3)
  status            BookingStatus @default(pending_payment)
  holdExpiresAt     DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  totalKobo         Int           @map("total_kobo")
  depositDueKobo    Int           @map("deposit_due_kobo")
  customerNote      String        @default("") @map("customer_note")
  privateNote       String        @default("") @map("private_note")
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           BookingItem[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]
  paymentLinks    PaymentLink[]
  notifications   Notification[]

  @@index([startAt])
  @@index([status, startAt])
  @@index([customerId])
  @@map("bookings")
}

/// One row per main service, add-on or on-the-day extra. Price and duration are copied at the time.
model BookingItem {
  id              String          @id @default(cuid())
  bookingId       String          @map("booking_id")
  serviceId       String?         @map("service_id")
  kind            BookingItemKind
  name            String
  priceKobo       Int             @map("price_kobo")
  durationMinutes Int             @map("duration_minutes")
  note            String          @default("")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_items")
}

// ───────────────────────────── Payments ─────────────────────────────

/// Append-only ledger of money received. Rows are never edited or deleted;
/// corrections are new `adjustment` rows (negative amounts allowed only there).
/// Balance owed = booking total minus the sum of successful payments.
model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @map("booking_id")
  type              PaymentType
  method            PaymentMethod
  /// What counts toward the booking. Never includes a fee the customer paid on top.
  amountKobo        Int           @map("amount_kobo")
  /// Paystack's fee when it was added to the customer's charge ("pass fees to customers"). Not ours.
  customerFeeKobo   Int           @default(0) @map("customer_fee_kobo")
  /// Paystack's whole fee for the charge, as Verify reports it, whoever bore it. Null for manual entries.
  paystackFeeKobo   Int?          @map("paystack_fee_kobo")
  status            PaymentStatus @default(success)
  /// Unique when present, so a replayed webhook can never record the same charge twice.
  paystackReference String?       @unique @map("paystack_reference")
  recordedById      String?       @map("recorded_by_id")
  note              String        @default("")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  recordedBy AdminUser? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([createdAt])
  @@map("payments")
}

/// One row per Paystack transaction we initialise. Mutable working state; the ledger is `Payment`.
model PaymentAttempt {
  id            String                @id @default(cuid())
  bookingId     String                @map("booking_id")
  purpose       PaymentAttemptPurpose
  reference     String                @unique
  amountKobo    Int                   @map("amount_kobo")
  accessCode    String?               @map("access_code")
  status        PaymentAttemptStatus  @default(initialized)
  paymentLinkId String?               @map("payment_link_id")
  /// When the scheduler last asked Paystack about it (backstop for a missed webhook).
  lastCheckedAt DateTime?             @map("last_checked_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentLink PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("payment_attempts")
}

/// Customer-facing payment link. URLs carry the token; only its hash is stored.
model PaymentLink {
  id          String             @id @default(cuid())
  tokenHash   String             @unique @map("token_hash")
  bookingId   String             @map("booking_id")
  purpose     PaymentLinkPurpose
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?          @map("used_at") @db.Timestamptz(3)
  createdById String?            @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  createdBy AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attempts  PaymentAttempt[]

  @@index([bookingId])
  @@map("payment_links")
}

/// Every incoming Paystack event, kept for idempotency and as evidence in disputes.
model WebhookEvent {
  id             String             @id @default(cuid())
  provider       String             @default("paystack")
  eventType      String             @map("event_type")
  reference      String?
  payload        Json
  signatureValid Boolean            @map("signature_valid")
  sourceIp       String?            @map("source_ip")
  status         WebhookEventStatus @default(received)
  error          String?
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@index([reference])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// ───────────────────────────── Notifications ─────────────────────────────

/// Messages to send. Created in the same transaction as the event that causes them;
/// sent later by the scheduler. `dedupeKey` (for example `reminder:<bookingId>` or
/// `summary:2026-12-01`) guarantees one row per message.
model Notification {
  id                String              @id @default(cuid())
  dedupeKey         String              @unique @map("dedupe_key")
  bookingId         String?             @map("booking_id")
  customerId        String?             @map("customer_id")
  type              NotificationType
  channel           NotificationChannel
  status            NotificationStatus  @default(pending)
  dueAt             DateTime            @map("due_at") @db.Timestamptz(3)
  attempts          Int                 @default(0)
  /// Not before this time: the next retry after a failure, or a short claim while a run sends it.
  nextAttemptAt     DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  lastError         String?             @map("last_error")
  providerMessageId String?             @map("provider_message_id")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  /// Free-form content for owner alerts (booking-related types render from the booking).
  payload           Json?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([bookingId])
  @@map("notifications")
}

// ───────────────────────────── Settings and blocks ─────────────────────────────

/// Single row (id = 1). JSON columns are validated with Zod in src/domain/settings.ts.
model Settings {
  id                  Int          @id @default(1)
  timezone            String       @default("Africa/Lagos")
  slotIntervalMinutes Int          @default(30) @map("slot_interval_minutes")
  bufferMinutes       Int          @default(0) @map("buffer_minutes")
  holdMinutes         Int          @default(15) @map("hold_minutes")
  minimumLeadMinutes  Int          @default(120) @map("minimum_lead_minutes")
  bookingHorizonDays  Int          @default(60) @map("booking_horizon_days")
  /// { "0": null | { "open": "09:00", "close": "18:00" }, ... "6": ... } with 0 = Sunday.
  weeklyHours         Json         @map("weekly_hours")
  /// { "0": 0, "1": 2, ... "6": 2 }: customers served at once, per weekday.
  capacityByWeekday   Json         @map("capacity_by_weekday")
  depositType         DepositType  @default(percent) @map("deposit_type")
  depositFixedKobo    Int          @default(0) @map("deposit_fixed_kobo")
  depositPercent      Int          @default(30) @map("deposit_percent")
  depositScope        DepositScope @default(full_total) @map("deposit_scope")
  /// Optional floor for percentage deposits. Null means no minimum.
  depositMinimumKobo  Int?         @map("deposit_minimum_kobo")
  messageTemplates    Json         @map("message_templates")
  salonDetails        Json         @map("salon_details")
  schedulerHeartbeat  DateTime?    @map("scheduler_heartbeat") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// Admin-created period that reduces capacity (or closes the salon when capacityReduction is null).
model Block {
  id                String   @id @default(cuid())
  startAt           DateTime @map("start_at") @db.Timestamptz(3)
  endAt             DateTime @map("end_at") @db.Timestamptz(3)
  capacityReduction Int?     @map("capacity_reduction")
  reason            String   @default("")
  createdById       String?  @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startAt, endAt])
  @@map("blocks")
}

// ───────────────────────────── Finances ─────────────────────────────

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(cuid())
  /// Calendar day in Lagos time.
  date        DateTime      @db.Date
  amountKobo  Int           @map("amount_kobo")
  categoryId  String        @map("category_id")
  method      PaymentMethod
  note        String        @default("")
  createdById String?       @map("created_by_id")
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category  ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy AdminUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("expenses")
}

// ───────────────────────────── Admin, security and audit ─────────────────────────────

model AdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  displayName       String    @map("display_name")
  /// PBKDF2 hash in the form pbkdf2-sha256$<iterations>$<salt b64url>$<hash b64url>.
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// TOTP secret, encrypted with a key derived from AUTH_SECRET. Set during setup;
  /// 2FA is only active once totpEnabledAt is set.
  totpSecret        String?   @map("totp_secret")
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// SHA-256 hashes of unused one-time backup codes.
  backupCodeHashes  String[]  @default([]) @map("backup_code_hashes")
  /// Last TOTP time step accepted, so a code can never be used twice.
  lastTotpStep      Int?      @map("last_totp_step")
  /// Consecutive failed sign-ins. Waits grow after 5; reset on success. No hard lockout.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  loginBlockedUntil DateTime? @map("login_blocked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     AdminSession[]
  payments     Payment[]
  paymentLinks PaymentLink[]
  blocks       Block[]
  expenses     Expense[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AdminSession {
  id          String   @id @default(cuid())
  /// SHA-256 of the session cookie value.
  tokenHash   String   @unique @map("token_hash")
  adminUserId String   @map("admin_user_id")
  /// False between a correct password and a correct 2FA code.
  mfaVerified Boolean  @default(false) @map("mfa_verified")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

/// Fixed-window counters for rate limiting, shared by every server instance.
model RateLimitBucket {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  /// "Customer", "System", "Paystack" or the admin's display name.
  actorLabel String   @map("actor_label")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  bookingId  String?  @map("booking_id")
  customerId String?  @map("customer_id")
  summary    String
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([customerId])
  @@index([createdAt])
  @@map("audit_logs")
}

/**
 * ───────────────────────── Locs Mastery programs ─────────────────────────
 */

enum ApplicationStatus {
  new
  contacted
  accepted
  declined
  withdrawn

  @@map("application_status")
}

enum ExperienceLevel {
  none
  some
  working

  @@map("experience_level")
}

/// A training program shown on /locs-mastery. Edited by the owner in Settings; no price is shown.
model Program {
  id                    String   @id @default(cuid())
  name                  String
  summary               String
  /// For example "6 weeks" or "3 days".
  duration              String
  /// For example "In the salon, Saturdays 10am to 4pm".
  format                String   @default("")
  /// Who it suits, for example "Complete beginners".
  level                 String   @default("")
  /// What a student learns, one item per entry.
  outcomes              String[] @default([])
  /// The program fee in kobo, shown on the page. Null: the fee is shared after someone applies.
  priceKobo             Int?     @map("price_kobo")
  /// Listed on the page.
  active                Boolean  @default(true)
  /// Open for applications. A listed program can be closed ("next intake soon").
  acceptingApplications Boolean  @default(true) @map("accepting_applications")
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  applications ProgramApplication[]

  @@map("programs")
}

/// An application to a program, with basic personal details (no ID documents).
model ProgramApplication {
  id               String            @id @default(cuid())
  /// Shown to the applicant, for example "LM-7KQ2X9".
  reference        String            @unique
  programId        String            @map("program_id")
  fullName         String            @map("full_name")
  /// E.164.
  phone            String
  email            String
  /// A calendar date.
  dateOfBirth      DateTime          @map("date_of_birth") @db.Date
  city             String
  state            String
  experience       ExperienceLevel
  motivation       String
  howHeard         String            @default("") @map("how_heard")
  marketingConsent Boolean           @default(false) @map("marketing_consent")
  /// When the applicant agreed to their details being used for the application.
  consentAt        DateTime          @map("consent_at") @db.Timestamptz(3)
  status           ApplicationStatus @default(new)
  privateNote      String            @default("") @map("private_note")
  statusChangedAt  DateTime?         @map("status_changed_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([programId])
  @@index([phone])
  @@map("program_applications")
}
