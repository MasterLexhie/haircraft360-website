{
  "name": "haircraft360",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "cron": "tsx --env-file=.env.local scripts/cron.ts",
    "admin": "tsx scripts/admin-user.ts",
    "remote:migrate": "node --env-file=.env.remote.local node_modules/prisma/build/index.js migrate deploy",
    "remote:admin": "tsx --env-file=.env.remote.local scripts/admin-user.ts"
  },
  "dependencies": {
    "@paystack/inline-js": "2.28.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "libphonenumber-js": "1.13.16",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  }
}
